# ===== 服务配置 =====
PORT=3000

# ===== 阿里云邮件推送 DirectMail SMTP =====
# SMTP 地址：smtpdm.aliyun.com，端口 465（SSL）
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
# 465 端口必须为 true（SSL）
SMTP_SECURE=true
# 发信账号（完整邮箱地址）
SMTP_USER=noreply@qq.jadebeads.cn
# SMTP 密码（在阿里云 DirectMail 控制台「发信地址」里获取/设置）
SMTP_PASS=在这里填写你的SMTP密码
# 邮件 From 显示名与地址
SMTP_FROM=迹时 <noreply@qq.jadebeads.cn>

# ===== 阿里云 DirectMail 模板 ID =====
# 注意：SMTP 直发模式（nodemailer）不使用模板，邮件内容由服务端直接构造。
# 该 ID 仅在改用阿里云 SingleSendMail API（模板发信）时使用，此处保留作参考。
SMTP_TEMPLATE_ID=444380

# ===== 验证码有效期（毫秒），默认 10 分钟 =====
CODE_TTL_MS=600000

# ===== CORS 允许的来源（多个用英文逗号分隔；留空则允许所有来源，便于联调）=====
CORS_ORIGIN=https://time.jadebeads.cn,http://localhost:5173

# ===== 智能识别（#6 DeepSeek）=====
# 总开关：true = 不调用云端，直接返回模拟数据（前端联调时使用）
PLAN_RECOGNIZE_MOCK=true

# DeepSeek API Key（控制台 https://platform.deepseek.com 创建）
DEEPSEEK_API_KEY=sk-在这里填写你的DeepSeek密钥
# 自定义 Base URL（一般留空使用官方）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 模型（支持视觉：deepseek-chat 已支持图片理解）
DEEPSEEK_MODEL=deepseek-chat

# 上传文件大小限制（MB）
PLAN_UPLOAD_LIMIT_MB=10
